# Copie este arquivo para .env e preencha com seus valores:
#   cp .env.example .env
#
# Dashboard Supabase → Settings → API
# ============================================================

SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_ANON_KEY=eyJSEU_TOKEN_AQUI

# Agora
# ============================================================
AGORA_APP_ID=SEU_AGORA_APP_ID
AGORA_TEMP_TOKEN=

# Firebase Web Credentials
# ============================================================
FIREBASE_WEB_API_KEY=SUA_API_KEY
FIREBASE_WEB_APP_ID=SEU_APP_ID
FIREBASE_WEB_MESSAGING_SENDER_ID=SEU_SENDER_ID
FIREBASE_WEB_PROJECT_ID=SEU_PROJECT_ID
FIREBASE_VAPID_KEY=SUA_CHAVE_VAPID_AQUI

# Integrações
# ============================================================
N8N_TRANSCRIPTION_WEBHOOK_URL=https://seu-webhook/transcrever-chunk
